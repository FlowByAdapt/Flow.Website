---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Revit Tools | Flow by Adapt"
	description="Explore the Flow suite of practical Revit tools designed by architectural designers to improve everyday BIM and documentation workflows."
>
	<section class="tools-page">
		<div class="tools-intro">
			<p class="eyebrow">FLOW TOOLS</p>

			<h1>Practical tools for everyday Revit workflows.</h1>

			<p class="tools-lead">
				Flow is a growing collection of Revit tools developed around
				real architectural workflows — reducing repetitive tasks,
				improving consistency and making common processes easier to manage.
			</p>
		</div>
	</section>


	<!-- =====================================================
	     PROJECT & WORKSPACE
	     ===================================================== -->

	<section class="tool-catalogue">
		<div class="tool-catalogue__inner">

			<div class="tool-section-heading">
				<p class="eyebrow">PROJECT & WORKSPACE</p>

				<h2>Start, organise and navigate your projects.</h2>

				<p>
					Tools for setting up projects, managing your workspace and
					getting to the commands and controls you use most often.
				</p>
			</div>

			<div class="tool-grid">

				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/project_setup.png"
						alt="Flow Project Setup interface"
					/>

					<h3>Project Setup</h3>

					<p>
						Create and configure Revit projects using consistent
						templates, project information, folders, worksets and standards.
					</p>

					<a href="https://help.flowbyadapt.com/project/project-setup/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/workspace.png"
						alt="Flow Workspace interface"
					/>

					<h3>Workspace</h3>

					<p>
						Save and restore Revit window arrangements and recover your
						workspace when windows become difficult to find.
					</p>

					<a href="https://help.flowbyadapt.com/workspace/workspace/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/command-palette.png"
						alt="Flow Command Palette interface"
					/>

					<h3>Command Palette</h3>

					<p>
						Find and launch Flow and Revit commands quickly without
						navigating through ribbon panels.
					</p>

					<a href="https://help.flowbyadapt.com/workspace/command-palette/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image tool-card__image--tall"
						src="/assets/visibility-manager.png"
						alt="Flow Visibility Manager interface"
					/>

					<h3>Visibility Manager</h3>

					<p>
						Bring commonly used project, active-view and application
						visibility controls together in one convenient location.
					</p>

					<a href="https://help.flowbyadapt.com/workspace/visibility-manager/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image tool-card__image--tall"
						src="/assets/flow-hub.png"
						alt="Flow Hub interface"
					/>

					<h3>Flow Hub</h3>

					<p>
						Access frequently used Flow tools, project controls,
						content and workspace functions from a central dockable interface.
					</p>

					<a href="https://help.flowbyadapt.com/workspace/flow-hub/">
						Learn more
					</a>
				</article>

			</div>
		</div>
	</section>


	<!-- =====================================================
	     CONTENT & STANDARDS
	     ===================================================== -->

	<section class="tool-catalogue">
		<div class="tool-catalogue__inner">

			<div class="tool-section-heading">
				<p class="eyebrow">CONTENT & STANDARDS</p>

				<h2>Build, manage and maintain consistent content.</h2>

				<p>
					Tools for finding, maintaining and preparing Revit content,
					type catalogues, drafting resources and supporting standards.
				</p>
			</div>

			<div class="tool-grid">

				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/content_browser.png"
						alt="Flow Content Browser interface"
					/>

					<h3>Content Browser</h3>

					<p>
						Find, review and load approved Revit families and drafting
						content from a central content library.
					</p>

					<a href="https://help.flowbyadapt.com/content/content-browser/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/type-catalogue.png"
						alt="Flow Type Catalogue interface"
					/>

					<h3>Type Catalogue</h3>

					<p>
						Create, edit, validate and maintain Revit family type
						catalogues using consistent parameter data.
					</p>

					<a href="https://help.flowbyadapt.com/content/type-catalogue-manager/">
						Learn more
					</a>
				</article>


				<article class="tool-card tool-card--process">
					<div class="tool-process">
						<span>Select files</span>
						<span class="tool-process__arrow">→</span>
						<span>Extract views</span>
						<span class="tool-process__arrow">→</span>
						<span>Reuse</span>
					</div>

					<h3>Drafting Views</h3>

					<p>
						Extract reusable drafting views from selected Revit files
						and prepare them for use across projects and standard
						documentation workflows.
					</p>

					<a href="https://help.flowbyadapt.com/content/drafting-views/">
						Learn more
					</a>
				</article>


				<article class="tool-card tool-card--process">
					<div class="tool-process">
						<span>Select families</span>
						<span class="tool-process__arrow">→</span>
						<span>Generate</span>
						<span class="tool-process__arrow">→</span>
						<span>Preview</span>
					</div>

					<h3>Preview Generator</h3>

					<p>
						Batch-generate consistent preview images for selected
						Revit families, making content easier to recognise and browse.
					</p>

					<a href="https://help.flowbyadapt.com/content/preview-generator/">
						Learn more
					</a>
				</article>


				<article class="tool-card tool-card--process">
					<div class="tool-process">
						<span>Select files</span>
						<span class="tool-process__arrow">→</span>
						<span>Upgrade</span>
						<span class="tool-process__arrow">→</span>
						<span>Save</span>
					</div>

					<h3>Revit Upgrade</h3>

					<p>
						Upgrade batches of Revit files to newer versions without
						manually opening, processing and saving each file individually.
					</p>

					<a href="https://help.flowbyadapt.com/content/revit-upgrade/">
						Learn more
					</a>
				</article>

			</div>
		</div>
	</section>


	<!-- =====================================================
	     MODEL & DOCUMENTATION
	     ===================================================== -->

	<section class="tool-catalogue">
		<div class="tool-catalogue__inner">

			<div class="tool-section-heading">
				<p class="eyebrow">MODEL & DOCUMENTATION</p>

				<h2>Turn repetitive modelling into managed workflows.</h2>

				<p>
					Tools for coordinating model information, documentation,
					parameters, openings and other recurring production tasks.
				</p>
			</div>

			<div class="tool-grid">

				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/openings_dashboard.png"
						alt="Flow Openings Manager interface"
					/>

					<h3>Openings Manager</h3>

					<p>
						Review, standardise, number, tag and document doors,
						windows and other opening-related project information.
					</p>

					<a href="https://help.flowbyadapt.com/model/openings-manager/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/parameters-manager.png"
						alt="Flow Parameters Manager interface"
					/>

					<h3>Parameters Manager</h3>

					<p>
						Review and maintain global, project and family parameter
						workflows across Revit projects and content.
					</p>

					<a href="https://help.flowbyadapt.com/model/parameters-manager/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/pattern_manager.png"
						alt="Flow Pattern Manager interface"
					/>

					<h3>Pattern Manager</h3>

					<p>
						Browse, create, edit and standardise Revit fill patterns,
						including pattern generation from model geometry.
					</p>

					<a href="https://help.flowbyadapt.com/model/pattern-manager/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image tool-card__image--tall"
						src="/assets/area-envelope.png"
						alt="Flow Area Envelope interface"
					/>

					<h3>Area Envelope</h3>

					<p>
						Create repeatable area-boundary workflows around framing
						and cladding geometry for project area calculations.
					</p>

					<a href="https://help.flowbyadapt.com/model/area-envelope/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image tool-card__image--tall"
						src="/assets/keynotes.png"
						alt="Flow Keynotes interface"
					/>

					<h3>Keynotes</h3>

					<p>
						Manage project keynote information and support consistent
						keynote workflows across Revit projects.
					</p>

					<a href="https://help.flowbyadapt.com/model/keynotes/">
						Learn more
					</a>
				</article>

			</div>
		</div>
	</section>


	<!-- =====================================================
	     REVIEW & RISK
	     ===================================================== -->

	<section class="tool-catalogue">
		<div class="tool-catalogue__inner">

			<div class="tool-section-heading">
				<p class="eyebrow">REVIEW & RISK</p>

				<h2>Make project issues easier to see and act on.</h2>

				<p>
					Tools for reviewing model quality, identifying project risks
					and turning complex information into clearer project decisions.
				</p>
			</div>

			<div class="tool-grid">

				<article class="tool-card">
					<img
						class="tool-card__image"
						src="/assets/model_health.png"
						alt="Flow Model Health interface"
					/>

					<h3>Model Health</h3>

					<p>
						Run focused model-health checks, review project issues
						and identify areas that may need attention.
					</p>

					<a href="https://help.flowbyadapt.com/model/model-health/">
						Learn more
					</a>
				</article>


				<article class="tool-card">
					<img
						class="tool-card__image tool-card__image--tall"
						src="/assets/risk_matrix.png"
						alt="Flow Risk Matrix interface"
					/>

					<h3>Risk Matrix</h3>

					<p>
						Identify exterior risk faces, assign E2 risk information
						and support consistent risk documentation within Revit.
					</p>

					<a href="https://help.flowbyadapt.com/model/risk-matrix/">
						Learn more
					</a>
				</article>

			</div>
		</div>
	</section>


	<!-- =====================================================
	     FLOW CONTINUES TO GROW
	     ===================================================== -->

	<section class="tools-closing">
		<div class="tools-closing__inner">

			<p class="eyebrow">FLOW CONTINUES TO GROW</p>

			<h2>Built around the work that actually needs doing.</h2>

			<p>
				Flow continues to develop around practical architectural and Revit
				workflows. New tools and improvements are introduced where they can
				remove repetition, improve consistency or make everyday work easier
				to manage.
			</p>

			<a href="https://help.flowbyadapt.com/">
				Explore Flow.Help
			</a>

		</div>
	</section>

</BaseLayout>