<!-- Run before the page paints so saved preferences do not flash the wrong theme. -->
<script is:inline>
	(() => {
		const root = document.documentElement;
		const system = window.matchMedia('(prefers-color-scheme: dark)');
		let preference = 'system';
		try {
			const saved = localStorage.getItem('flow-theme');
			if (['system', 'light', 'dark'].includes(saved)) preference = saved;
		} catch { /* Theme switching still works when browser storage is unavailable. */ }
		const apply = () => {
			root.dataset.themePreference = preference;
			root.dataset.theme = preference === 'system' ? (system.matches ? 'dark' : 'light') : preference;
		};
		apply();
		system.addEventListener('change', apply);
		document.addEventListener('flow:theme-change', (event) => {
			if (!['system', 'light', 'dark'].includes(event.detail)) return;
			preference = event.detail;
			try { localStorage.setItem('flow-theme', preference); } catch {}
			apply();
		});
		window.addEventListener('storage', (event) => {
			if (event.key !== 'flow-theme' && event.key !== null) return;
			preference = ['light', 'dark'].includes(event.newValue) ? event.newValue : 'system';
			apply();
		});
	})();
</script>
