---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="site-footer">
    <div class="footer-inner">

        <img
            src={`${base}/branding/flow-logo-dark.png`}
            alt="Flow by Adapt"
            class="footer-logo"
        />

        <p>
            Revit tools shaped by architectural practice.
        </p>

        <nav class="footer-nav" aria-label="Footer navigation">

            <a href={`${base}/`}>
                Home
            </a>

            <a href={`${base}/tools`}>
                Tools
            </a>

            <a
                href="https://help.flowbyadapt.com/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Flow.Help
            </a>

            <a
                href="https://help.flowbyadapt.com/legal/terms-of-use/"
                target="_blank"
                rel="noopener noreferrer"
            >
                Terms of Use &amp; Privacy
            </a>

        </nav>

    </div>
</footer>