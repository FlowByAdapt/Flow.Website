---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="site-header">
	<div class="header-inner">
		<a
			class="site-brand"
			href={`${base}/`}
			aria-label="Flow by Adapt home"
		>
			<img
				src={`${base}/branding/flow-logo-dark.png`}
				alt="Flow by Adapt"
				class="site-logo"
			/>
		</a>

		<nav class="site-nav" aria-label="Primary">
			<a href={`${base}/#tools`}>Tools</a>
			<a href={`${base}/#origin`}>About</a>
			<a
				href="https://help.flowbyadapt.com/"
				target="_blank"
				rel="noopener noreferrer"
			>
				Help
			</a>
			<a href={`${base}/#contact`}>Contact</a>
		</nav>
	</div>
</header>