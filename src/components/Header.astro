---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const currentPath = Astro.url.pathname;

const isHome =
	currentPath === `${base}/` ||
	currentPath === "/";

const isTools =
	currentPath === `${base}/tools` ||
	currentPath === "/tools";

const isInsights =
	currentPath === `${base}/insights` ||
	currentPath === `${base}/insights/` ||
	currentPath === "/insights" ||
	currentPath === "/insights/" ||
	currentPath.startsWith(`${base}/insights/`) ||
	currentPath.startsWith("/insights/");

const isAbout =
	currentPath === `${base}/about` ||
	currentPath === "/about";

const isContact =
	currentPath === `${base}/contact` ||
	currentPath === "/contact";
---

<header class="site-header">
	<div class="header-inner">
		<a
			class="site-brand"
			href={`${base}/`}
			aria-label="Flow by Adapt home"
		>
			<img
				src={`${base}/branding/flow-logo-dark.png`}
				alt="Flow by Adapt"
				class="site-logo"
			/>
		</a>

		<nav class="site-nav" aria-label="Primary">
			<a
				href={`${base}/`}
				class:list={{ active: isHome }}
			>
				Home
			</a>

			<a
				href={`${base}/tools`}
				class:list={{ active: isTools }}
			>
				Tools
			</a>

			<a
				href={`${base}/insights`}
				class:list={{ active: isInsights }}
			>
				Insights
			</a>

			<a
				href={`${base}/about`}
				class:list={{ active: isAbout }}
			>
				About
			</a>

			<a
				href="https://help.flowbyadapt.com/"
				target="_blank"
				rel="noopener noreferrer"
			>
				Help
			</a>
			<a
				href={`${base}/contact`}
				class:list={{ active: isContact }}
			>
				Contact
			</a>
		</nav>
	</div>
</header>