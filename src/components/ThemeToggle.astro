<button class="theme-toggle" type="button" aria-label="Theme: System. Switch to light mode" title="Theme: System. Switch to light mode" hidden>
	<svg class="theme-icon theme-icon-system" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
	<svg class="theme-icon theme-icon-light" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
	<svg class="theme-icon theme-icon-dark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const root = document.documentElement;
	const modes = ['system', 'light', 'dark'];
	const updateLabel = () => {
		const current = root.dataset.themePreference ?? 'system';
		const next = modes[(modes.indexOf(current) + 1) % modes.length];
		const label = `Theme: ${current[0].toUpperCase() + current.slice(1)}. Switch to ${next === 'system' ? 'system preference' : `${next} mode`}`;
		button?.setAttribute('aria-label', label);
		button?.setAttribute('title', label);
	};
	if (button) {
		button.hidden = false;
		updateLabel();
		new MutationObserver(updateLabel).observe(root, { attributes: true, attributeFilter: ['data-theme-preference'] });
		button.addEventListener('click', () => {
			const current = root.dataset.themePreference ?? 'system';
			document.dispatchEvent(new CustomEvent('flow:theme-change', { detail: modes[(modes.indexOf(current) + 1) % modes.length] }));
		});
	}
</script>
