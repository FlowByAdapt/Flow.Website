---
import { applications } from "../data/applications";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="applications-feature" aria-labelledby="applications-heading">
    <div class="section-content">
        <div class="feature-panel">
            <p class="eyebrow">Flow Applications</p>
            <h2 id="applications-heading">Applications for running your practice</h2>
            <ul>
                {applications.map(({ name, summary }) => (
                    <li>
                        <h3>{name}</h3>
                        <p>{summary}</p>
                    </li>
                ))}
            </ul>
            <a class="button primary" href={`${base}/applications/`}>Explore Flow applications</a>
        </div>
    </div>
</section>

<style>
    .applications-feature {
        padding: clamp(2.5rem, 5vw, 4rem) var(--flow-page-padding) clamp(3rem, 7vw, 6rem);
    }

    .feature-panel {
        padding: clamp(1.5rem, 5vw, 3rem);
        background:
            linear-gradient(var(--flow-surface), var(--flow-surface)) padding-box,
            linear-gradient(90deg, var(--flow-blue), var(--flow-purple), var(--flow-pink)) border-box;
        border: solid transparent;
        border-width: 2px 0 0;
        border-radius: var(--flow-radius-medium);
    }

    h2 {
        margin: 0 0 1.5rem;
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
    }

    ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
        margin: 0 0 1.75rem;
        padding: 0;
        list-style: none;
    }

    h3 {
        margin: 0 0 0.35rem;
        font-size: 1.08rem;
    }

    li p {
        margin: 0;
        color: var(--flow-text-secondary);
    }

    @media (max-width: 700px) {
        ul {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
