---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	type?: "website" | "article";
	publishedTime?: Date;
	author?: string;
	category?: string;
}

const {
	title = "Flow by Adapt | Revit Tools for Architectural Workflows",
	description = "Flow is a growing suite of Revit tools designed and tested by experienced architectural designers to solve real-world workflow problems.",
	canonicalPath = Astro.url.pathname,
	image = "/branding/flow-logo-dark.png",
	type = "website",
	publishedTime,
	author,
	category
} = Astro.props;

const siteURL = Astro.site ?? Astro.url.origin;

const canonicalURL = new URL(
	canonicalPath,
	siteURL
);

const socialImageURL = new URL(
	image,
	siteURL
);

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": `${siteURL}#organization`,
			"name": "Flow by Adapt",
			"url": siteURL.toString()
		},
		{
			"@type": "WebSite",
			"@id": `${siteURL}#website`,
			"url": siteURL.toString(),
			"name": "Flow by Adapt",
			"description": "Practical Revit tools for architectural workflows.",
			"publisher": {
				"@id": `${siteURL}#organization`
			}
		}
	]
};

const articleStructuredData =
	type === "article"
		? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": title.replace(" | Flow by Adapt", ""),
			"description": description,
			"url": canonicalURL.toString(),
			"image": socialImageURL.toString(),
			"datePublished": publishedTime?.toISOString(),
			"articleSection": category,
			"author": {
				"@type": "Organization",
				"name": author ?? "Flow by Adapt"
			},
			"publisher": {
				"@id": `${siteURL}#organization`
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": canonicalURL.toString()
			}
		}
		: null;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-74NR0BKB4M"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-74NR0BKB4M');
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Primary SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Flow by Adapt" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />

		{type === "article" && publishedTime && (
			<meta
				property="article:published_time"
				content={publishedTime.toISOString()}
			/>
		)}

		{type === "article" && author && (
			<meta
				property="article:author"
				content={author}
			/>
		)}

		<!-- Social sharing -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<!-- Structured data -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		></script>

		{articleStructuredData && (
			<script
				type="application/ld+json"
				set:html={JSON.stringify(articleStructuredData)}
			></script>
		)}

		<!-- Branding -->
		<link rel="icon" type="image/png" href="/flow-favicon.png" />
	</head>

	<body>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>