---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Flow by Adapt",
	description = "Flow is a growing suite of Revit tools designed and tested by experienced architectural designers to solve real-world workflow problems."
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<link rel="icon" type="image/png" href="/flow-favicon.png" />

		<meta name="description" content={description} />

		<title>{title}</title>
	</head>

	<body>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>